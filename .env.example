# ---------- Fallback AI (Hidden behind secret access code on public deployments) ----------
# Set FALLBACK_SECRET_CODE to require a secret code before anyone can use the server's AI key.
# Leave unset only for private local development.
FALLBACK_SECRET_CODE="CHANGE_ME_SECRET_CODE"

# Fallback AI provider: gemini | openrouter | openai | groq | ollama | custom
FALLBACK_AI_PROVIDER="gemini"
FALLBACK_AI_API_KEY="MY_GEMINI_OR_PROVIDER_API_KEY"
FALLBACK_AI_MODEL="gemini-3.8-flash"

# Legacy / direct Gemini env vars (also supported as fallback)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# Optional local Node server port
PORT=3000
